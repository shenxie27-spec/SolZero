{
    acme_ca https://acme-v02.api.letsencrypt.org/directory
}

api.solzero.top {
    encode gzip
    reverse_proxy 127.0.0.1:8787
}

solzero.top {
    encode gzip
    root * /var/www/solzero
    try_files {path} {path}/index.html
    file_server
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
    }
}
